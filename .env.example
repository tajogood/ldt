# 복사해서 .env 로 저장한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.

# 공공데이터포털 일반 인증키 — Encoding 키를 그대로 붙여 넣어도 됩니다(자동으로 디코딩).
DATA_GO_KR_KEY=

# 농식품 빅데이터 포털(data.mafra.go.kr) 마이페이지 인증키
MAFRA_KEY=

# 국토교통부 브이월드(www.vworld.kr) 오픈API 인증키 — 배경지도
#   인증키 관리에서 서비스 URL 에 http://localhost (운영 시 실제 도메인)가 등록돼 있어야 타일이 뜹니다.
VWORLD_KEY=
# 서버에서 주소→좌표 변환을 부를 때 쓰는 서비스 URL (키에 등록한 값)
VWORLD_DOMAIN=http://localhost

# 카카오 REST API 키 (주소 → 좌표 변환용, 선택)
KAKAO_REST_KEY=

# PostgreSQL (docker compose up -d 로 띄운 ldt-db)
# 비워 두면 data/ldt.sqlite3 (SQLite) 로 동작합니다.
DATABASE_URL=postgresql+psycopg://ldt:ldt@localhost:5433/ldt

# 1 이면 페이지 단위 원본 JSON 파일도 data/raw/ 에 남깁니다(DB raw_record 에는 항상 저장).
KEEP_RAW_FILES=0

# 자동 수집 — 서버가 켜져 있는 동안 매일 한 번 최신화 (처음 켤 때 DB가 비어 있으면 전체 수집)
AUTO_COLLECT=1
AUTO_COLLECT_AT=04:30
# 자동 수집할 그룹 (core, extra). extra 는 브루셀라 검사 35만 건 등 오래 걸림
AUTO_COLLECT_GROUPS=core

# KAHIS 축산차량 방문 — 별도 수집기 ./visits.sh 가 최근 3년치를 채우고 매일 갱신(웹 서버와 따로 실행)
VISIT_YEARS=3
VISIT_PAUSE_SEC=1
VISIT_DAY_PAUSE_SEC=1
VISIT_BACKFILL=0

# 외부(같은 네트워크의 다른 기기)에서 접속하려면 0.0.0.0
HOST=127.0.0.1
